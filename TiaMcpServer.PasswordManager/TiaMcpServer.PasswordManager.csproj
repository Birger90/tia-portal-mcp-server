<Project Sdk="Microsoft.NET.Sdk">
  <!--
    "TiaMcp Passwortverwaltung": Windows-only WinForms tool shipped next to the server (password-manager\ folder).
    It is not part of TiaMcpServer.slnx, so Linux builds never touch it; TiaMcpServer.csproj builds and copies it on
    Windows (BuildPasswordManager). Its non-UI logic lives in TiaMcpServer.Contracts (Shared/PasswordManagement) and is
    covered by the Linux-runnable tests.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TiaMcpPasswortverwaltung</AssemblyName>
    <RootNamespace>TiaMcpServer.PasswordManager</RootNamespace>
    <Product>TiaMcp Passwortverwaltung</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiaMcpServer.Contracts\TiaMcpServer.Contracts.csproj" />
  </ItemGroup>
</Project>
